    {
        "id": "ca6062a7095ce970",
        "type": "ui_template",
        "z": "87925ace8cbdac62",
        "group": "0981c3340180712c",
        "name": "Estado motor",
        "order": 1,
        "width": 6,
        "height": 4,
        "format": "<div style=\"padding:20px; font-family:'Segoe UI', Roboto, sans-serif;\">\n  <div style=\"display:flex; align-items:center; gap:18px;\">\n    <div ng-style=\"{\n        'width':'48px','height':'48px','min-width':'48px','border-radius':'50%',\n        'background-color':color,\n        'box-shadow': (color === '#2e7d32' ? '0 0 18px 4px rgba(46,125,50,0.6)' : (color === '#c62828' ? '0 0 18px 4px rgba(198,40,40,0.6)' : 'none')),\n        'transition':'all 0.4s ease'\n    }\"></div>\n    <div>\n      <div style=\"font-size:26px; font-weight:700; color:#fff; line-height:1.2;\">{{estado}}</div>\n      <div style=\"font-size:14px; color:#9e9e9e; margin-top:4px;\">{{baseDetalle}}</div>\n    </div>\n  </div>\n\n  <div ng-if=\"activadoEn\" style=\"margin-top:18px;\">\n    <div style=\"display:flex; justify-content:space-between; font-size:13px; color:#9e9e9e; margin-bottom:6px;\">\n      <span>Tiempo restante</span>\n      <span style=\"font-weight:600; color:#fff; font-size:16px;\">{{restante}}s</span>\n    </div>\n    <div style=\"background:#333; border-radius:6px; height:10px; overflow:hidden;\">\n      <div ng-style=\"{'width': (100 * restante / timeoutTotal) + '%', 'background-color': color, 'height':'100%', 'transition':'width 1s linear'}\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(scope){\n    scope.$watch('msg', function(msg) {\n        if (!msg || !msg.payload) return;\n\n        if (scope.interval) {\n            clearInterval(scope.interval);\n            scope.interval = null;\n        }\n\n        scope.estado = msg.payload.estado;\n        scope.color = msg.payload.color;\n        scope.baseDetalle = msg.payload.detalleBase || \"\";\n        scope.activadoEn = msg.payload.activadoEn || null;\n        scope.timeoutTotal = msg.payload.timeoutTotal || 1;\n\n        function actualizar() {\n            if (scope.activadoEn) {\n                scope.restante = Math.max(0, scope.timeoutTotal - Math.floor((Date.now() - scope.activadoEn) / 1000));\n            }\n        }\n\n        actualizar();\n        if (scope.activadoEn) {\n            scope.interval = setInterval(function() {\n                actualizar();\n                scope.$apply();\n            }, 1000);\n        }\n    });\n})(scope);\n</script>",
