    {
        "id": "074056561152d05f",
        "type": "function",
        "z": "87925ace8cbdac62",
        "name": "Override manual",
        "func": "const VELOCIDAD = flow.get('velocidadDeseada') || 3;\nconst TIMEOUT_SEGURIDAD_S = 180;\n\nif (msg.payload === \"manual_on\") {\n    const ahora = Date.now();\n    flow.set('motorActivo', true);\n    flow.set('activadoEn', ahora);\n    flow.set('prevStateInfo', 'Manual');\n\n    const accion = { payload: { velocidad: VELOCIDAD } };\n    const log = { evento: `Activación MANUAL (${VELOCIDAD}V)` };\n    const estado = { payload: {\n        estado: \"Motor activo (manual)\",\n        color: \"#2e7d32\",\n        detalleBase: \"Activado por botón\",\n        activadoEn: ahora,\n        timeoutTotal: TIMEOUT_SEGURIDAD_S\n    }};\n    node.status({ fill: \"green\", text: \"ACTIVADO MANUALMENTE\" });\n    return [accion, log, estado];\n}\n\nif (msg.payload === \"manual_off\") {\n    flow.set('motorActivo', false);\n    flow.set('activadoEn', null);\n    flow.set('prevStateInfo', 'Waiting for sample');\n\n    const accion = { payload: \"desactivar\" };\n    const log = { evento: \"Detención MANUAL\" };\n    const estado = { payload: {\n        estado: \"Motor parado\",\n        color: \"#9e9e9e\",\n        detalleBase: \"Detenido por botón\",\n        activadoEn: null,\n        timeoutTotal: TIMEOUT_SEGURIDAD_S\n    }};\n    node.status({ fill: \"grey\", text: \"DETENIDO MANUALMENTE\" });\n    return [accion, log, estado];\n}\n\nnode.status({});\nreturn [null, null, null];",
