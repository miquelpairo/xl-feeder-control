    {
        "id": "ui-velocidad",
        "type": "ui_template",
        "z": "87925ace8cbdac62",
        "group": "0981c3340180712c",
        "name": "Control de velocidad",
        "order": 6,
        "width": 6,
        "height": 3,
        "format": "<div style=\"padding:10px 4px;\">\n  <div style=\"display:flex; justify-content:space-between; font-size:13px; color:#9e9e9e; margin-bottom:6px;\">\n    <span>Velocidad (canal 5)</span>\n    <span>{{velocidad}} V</span>\n  </div>\n  <input type=\"range\" min=\"0\" max=\"9\" step=\"0.1\" ng-model=\"velocidad\" ng-change=\"onSlider()\"\n    style=\"width:100%;\">\n  <div style=\"display:flex; gap:10px; align-items:center; margin-top:10px;\">\n    <input type=\"number\" min=\"0\" max=\"9\" step=\"0.1\" ng-model=\"velocidad\" ng-change=\"onTexto()\"\n      style=\"width:80px; padding:6px; background:#222; color:#fff; border:1px solid #444; border-radius:6px;\">\n    <span style=\"font-size:12px; color:#666;\">0-9V</span>\n  </div>\n</div>\n\n<script>\n(function(scope){\n    scope.velocidad = 3;\n    scope.timer = null;\n\n    scope.enviar = function() {\n        scope.send({ payload: { velocidad: scope.velocidad } });\n    };\n\n    scope.onSlider = function() {\n        if (scope.timer) clearTimeout(scope.timer);\n        scope.timer = setTimeout(function(){\n            scope.enviar();\n            scope.$apply();\n        }, 300);\n    };\n\n    scope.onTexto = function() {\n        if (scope.timer) clearTimeout(scope.timer);\n        scope.timer = setTimeout(function(){\n            scope.enviar();\n            scope.$apply();\n        }, 500);\n    };\n\n    scope.$watch('msg', function(msg) {\n        if (msg && msg.payload && typeof msg.payload.velocidad === 'number') {\n            scope.velocidad = msg.payload.velocidad;\n        }\n    });\n})(scope);\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": false,
        "templateScope": "local",
