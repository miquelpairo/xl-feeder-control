    {
        "id": "54fcb28460b7eea5",
        "type": "function",
        "z": "87925ace8cbdac62",
        "name": "Detectar cruce lead-in",
        "func": "const UMBRAL_S = 10;\nconst VELOCIDAD = flow.get('velocidadDeseada') || 3;\nconst TIMEOUT_SEGURIDAD_S = 180;\n\nconst body = msg.payload || {};\nconst leadInStr = (body.UDP_State && body.UDP_State.LeadIn) || \"00:00\";\nconst stateInfo = body.StateInfo || \"\";\n\nconst partes = leadInStr.split(\":\").map(Number);\nconst leadInSeg = partes.length === 2 ? partes[0] * 60 + partes[1] : 0;\n\nlet motorActivo = flow.get('motorActivo') || false;\nlet prevStateInfo = flow.get('prevStateInfo') || \"\";\nlet activadoEn = flow.get('activadoEn') || null;\n\nconst estadoMsg = { payload: {\n    estado: motorActivo ? \"Motor activo\" : \"Motor parado\",\n    color: motorActivo ? \"#2e7d32\" : \"#9e9e9e\",\n    detalleBase: `${stateInfo} | LeadIn=${leadInSeg}s`,\n    activadoEn: motorActivo ? activadoEn : null,\n    timeoutTotal: TIMEOUT_SEGURIDAD_S\n}};\n\nlet accionMsg = null;\nlet logMsg = null;\n\nif (!motorActivo && stateInfo !== \"Measuring\" && leadInSeg > 0 && leadInSeg <= UMBRAL_S) {\n    flow.set('motorActivo', true);\n    flow.set('activadoEn', Date.now());\n    flow.set('prevStateInfo', stateInfo);\n    accionMsg = { payload: { velocidad: VELOCIDAD } };\n    logMsg = { evento: `Arranque automático a LeadIn=${leadInSeg}s` };\n    estadoMsg.payload.estado = \"Motor activo\";\n    estadoMsg.payload.color = \"#2e7d32\";\n    estadoMsg.payload.activadoEn = flow.get('activadoEn');\n    node.status({ fill: \"green\", text: `ARRANCA a LeadIn=${leadInSeg}s` });\n}\nelse if (motorActivo && prevStateInfo === \"Measuring\" && stateInfo === \"Waiting for sample\") {\n    flow.set('motorActivo', false);\n    flow.set('activadoEn', null);\n    flow.set('prevStateInfo', stateInfo);\n    accionMsg = { payload: \"desactivar\" };\n    logMsg = { evento: \"Parada automática (fin de medición)\" };\n    estadoMsg.payload.estado = \"Motor parado\";\n    estadoMsg.payload.color = \"#9e9e9e\";\n    estadoMsg.payload.activadoEn = null;\n    node.status({ fill: \"grey\", text: \"PARA (fin de medición)\" });\n}\nelse if (motorActivo && activadoEn && (Date.now() - activadoEn) / 1000 > TIMEOUT_SEGURIDAD_S) {\n    flow.set('motorActivo', false);\n    flow.set('activadoEn', null);\n    flow.set('prevStateInfo', stateInfo);\n    accionMsg = { payload: \"desactivar\" };\n    logMsg = { evento: `Parada por TIMEOUT de seguridad (${TIMEOUT_SEGURIDAD_S}s)` };\n    estadoMsg.payload.estado = \"Motor parado (timeout)\";\n    estadoMsg.payload.color = \"#c62828\";\n    estadoMsg.payload.activadoEn = null;\n    node.status({ fill: \"red\", text: `PARA por timeout (${TIMEOUT_SEGURIDAD_S}s)` });\n}\nelse {\n    flow.set('prevStateInfo', stateInfo);\n\n    if (motorActivo && activadoEn) {\n        const restante = Math.max(0, TIMEOUT_SEGURIDAD_S - Math.floor((Date.now() - activadoEn) / 1000));\n        node.status({\n            fill: \"green\",\n            text: `${stateInfo} | LeadIn=${leadInSeg}s | timeout en ${restante}s`\n        });\n    } else {\n        node.status({\n            fill: motorActivo ? \"green\" : \"grey\",\n            text: `${stateInfo} | LeadIn=${leadInSeg}s`\n        });\n    }\n}\n\nreturn [accionMsg, logMsg, estadoMsg];",
